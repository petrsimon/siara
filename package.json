{
  "name": "siara",
  "version": "0.1.0",
  "description": "SuperIntelligentAutoReviewerAssigner — deterministic PR reviewer assignment from team signals",
  "type": "module",
  "bin": {
    "siara": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dashboard": "node dist/cli.js dashboard --out public/index.html",
    "publish-log": "./scripts/log-crypt.sh encrypt"
  },
  "keywords": [
    "code-review",
    "reviewer-assignment",
    "github",
    "fairness"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
