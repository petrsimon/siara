{
  "name": "siara",
  "version": "0.1.0",
  "description": "SuperIntelligentAutoReviewerAssigner — deterministic PR reviewer assignment from team signals",
  "type": "module",
  "bin": {
    "siara": "./dist/cli.js"
  },
  "scripts": {
